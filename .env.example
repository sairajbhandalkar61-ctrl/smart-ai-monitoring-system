# ==============================================================================
# SENTINEL AI - Environment Configuration Template
# ==============================================================================

# --- CLOUD APPLICATION SETTINGS ---
APP_ENV=production
IS_CLOUD=true
PORT=8501
SECRET_KEY=generate_a_random_32_byte_secret_key_here

# PostgreSQL Database (Automatically injected by Railway / Render)
# Example: postgresql://user:password@host:5432/sentinel_db
DATABASE_URL=

# CORS
CORS_ALLOWED_ORIGINS=*

# --- DELL EDGE LAPTOP SETTINGS (Windows 11) ---
# Point to your deployed Railway domain (e.g., https://sentinel-ai.up.railway.app)
CLOUD_API_URL=http://127.0.0.1:8000
EDGE_DEVICE_ID=dell-edge-01
EDGE_DEVICE_TOKEN=sentinel_edge_secure_token_2026
CAMERA_INDEX=0
CAMERA_BACKEND=DSHOW
DETECTOR_TYPE=ssdlite
STORE_RAW_VIDEO=false
